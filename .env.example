# Copy to .env for local development. In production set these in Coolify.
DATABASE_URL=postgres://lart:lart@127.0.0.1:5432/lart
DATABASE_POOL_MAX=5
APP_URL=http://localhost:3000
# openssl rand -base64 32
ENCRYPTION_KEY=
# Resend (emails). Without a key, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="Lart <hello@example.com>"
